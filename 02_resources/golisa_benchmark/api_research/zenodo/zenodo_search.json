ttps://zenodo.org/api/records/17279584/draft", "access_links": "https://zenodo.org/api/records/17279584/access/links", "access_grants": "https://zenodo.org/api/records/17279584/access/grants", "access_users": "https://zenodo.org/api/records/17279584/access/users", "access_request": "https://zenodo.org/api/records/17279584/access/request", "access": "https://zenodo.org/api/records/17279584/access", "communities": "https://zenodo.org/api/records/17279584/communities", "communities-suggestions": "https://zenodo.org/api/records/17279584/communities-suggestions", "request_deletion": "https://zenodo.org/api/records/17279584/request-deletion", "file_modification": "https://zenodo.org/api/records/17279584/file-modification", "requests": "https://zenodo.org/api/records/17279584/requests"}, "updated": "2025-10-06T14:08:15.332833+00:00", "recid": "17279584", "revision": 4, "files": [{"id": "f87c0aeb-4dcd-41c4-b124-c8067ab37282", "key": "Background_Temperature_in_LLMs___arxiV.pdf", "size": 854342, "checksum": "md5:8e0e444d2d762a190436e75d6ff21a2e", "links": {"self": "https://zenodo.org/api/records/17279584/files/Background_Temperature_in_LLMs___arxiV.pdf/content"}}], "swh": null, "owners": [{"id": "1187858"}], "status": "published", "stats": {"downloads": 163, "unique_downloads": 116, "views": 147, "unique_views": 125, "version_downloads": 84, "version_unique_downloads": 60, "version_unique_views": 65, "version_views": 76}, "state": "done", "submitted": true}, {"created": "2019-06-28T14:04:00.555291+00:00", "modified": "2024-07-22T21:19:35.495406+00:00", "id": 3260521, "conceptrecid": "3260520", "doi": "10.5281/zenodo.3260521", "conceptdoi": "10.5281/zenodo.3260520", "doi_url": "https://doi.org/10.5281/zenodo.3260521", "metadata": {"title": "On Resolving Non-determinism in Choreographies", "doi": "10.5281/zenodo.3260521", "publication_date": "2019-06-28", "description": "<p>Choreographies specify multiparty interactions via message passing. A \\emph{realization} of a choreography is a composition of independent processes that behave as specified by the choreography. Existing relations of correctness/completeness between choreographies and realisations are based on models where choices are non-deterministic. Resolving non-deterministic choices into deterministic choices (e.g., conditional statements) is necessary to correctly characterise the relationship between choreographies and their implementations with concrete programming languages. We introduce a notion of realisability for choreographies --called whole-spectrum implementation-- where choices are still non-deterministic in choreographies, but are deterministic in their implementations. Our notion of whole spectrum implementation rules out deterministic implementations of roles that, no matter which context they are placed in, will never follow one of the branches of a non-deterministic choice. We give a type discipline for checking whole-spectrum implementations. As a case study, we analyse the POP protocol under the lens of whole-spectrum implementation.</p>", "access_right": "open", "creators": [{"name": "Bocchi, Laura", "affiliation": "University of Kent, UK"}, {"name": "Melgratti, Hern\u00e1n", "affiliation": "ICC"}, {"name": "Tuosto, Emilio", "affiliation": "G"}], "keywords": ["Multiparty session types"], "resource_type": {"title": "Report", "type": "publication", "subtype": "report"}, "license": {"id": "cc-by-4.0"}, "grants": [{"code": "778233", "internal_id": "10.13039/501100000780::778233", "funder": {"name": "European Commission", "doi": "10.13039/501100000780", "acronym": "EC"}, "title": "Behavioural Application Program Interfaces", "acronym": "BEHAPI", "program": "H2020-EU.1.3.", "url": "https://cordis.europa.eu/projects/778233"}], "communities": [{"id": "eu"}], "relations": {"version": [{"index": 0, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "3260520"}}]}}, "title": "On Resolving Non-determinism in Choreographies", "links": {"self": "https://zenodo.or