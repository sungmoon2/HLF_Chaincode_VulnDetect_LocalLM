ecords/10604024/access/grants", "access_users": "https://zenodo.org/api/records/10604024/access/users", "access_request": "https://zenodo.org/api/records/10604024/access/request", "access": "https://zenodo.org/api/records/10604024/access", "communities": "https://zenodo.org/api/records/10604024/communities", "communities-suggestions": "https://zenodo.org/api/records/10604024/communities-suggestions", "request_deletion": "https://zenodo.org/api/records/10604024/request-deletion", "file_modification": "https://zenodo.org/api/records/10604024/file-modification", "requests": "https://zenodo.org/api/records/10604024/requests"}, "updated": "2024-07-07T08:49:29.685471+00:00", "recid": "10604024", "revision": 6, "files": [{"id": "c3111f02-893b-479e-8e14-c8ad5eaa9189", "key": "1904.08337.pdf", "size": 852832, "checksum": "md5:55ab4454b69af4ee5ad06a6379d2476e", "links": {"self": "https://zenodo.org/api/records/10604024/files/1904.08337.pdf/content"}}], "swh": null, "owners": [{"id": "63273"}], "status": "published", "stats": {"downloads": 10, "unique_downloads": 10, "views": 13, "unique_views": 13, "version_downloads": 10, "version_unique_downloads": 10, "version_unique_views": 13, "version_views": 13}, "state": "done", "submitted": true}, {"created": "2017-03-29T14:26:20.649387+00:00", "modified": "2024-08-03T12:02:41.825326+00:00", "id": 439050, "conceptrecid": "793750", "doi": "10.5281/zenodo.439050", "conceptdoi": "", "doi_url": "https://doi.org/10.5281/zenodo.439050", "metadata": {"title": "Non-determinism in Byzantine Fault-Tolerant Replication", "doi": "10.5281/zenodo.439050", "publication_date": "2016-12-16", "description": "<p>Service replication distributes an application over many processes for tolerating faults, attacks, and misbehavior among a subset of the processes. With the recent interest in blockchain technologies, distributed execution of one logical application has become a prominent topic. The established state-machine replication paradigm inherently requires the application to be deterministic. This paper distinguishes three models for dealing with non-determinism in replicated services, where some processes are subject to faults and arbitrary behavior (so-called Byzantine faults): first, the modular case that does not require any changes to the potentially non-deterministic application (and neither access to its internal data); second, master-slave solutions, where ties are broken by a leader and the other processes validate the choices of the leader; and finally, applications that use cryptography and secret keys. Cryptographic operations and secrets must be treated specially because they require strong randomness to satisfy their goals. The paper also introduces two new protocols. First, Protocol Sieve uses the modular approach and filters out non-deterministic operations in an application. It ensures that all correct processes produce the same outputs and that their internal states do not diverge. A second protocol, called Mastercrypt, implements cryptographically secure randomness generation with a verifiable random function and is appropriate for most situations in which cryptographic secrets are involved. All protocols are described in a generic way and do not assume a particular implementation of the underlying consensus primitive.</p>", "access_right": "open", "creators": [{"name": "Cachin, Christian", "affiliation": "IBM"}, {"name": "Vukolic, Marko", "affiliation": "IBM"}, {"name": "Schubert, Simon", "affiliation": "IBM"}], "keywords": ["Blockchain", "atomic broadcast", "consensus", "distributed cryptography", "verifiable random functions"], "related_identifiers": [{"identifier": "10.4230/LIPIcs.CVIT.2016.23", "relation": "isPreviousVersionOf", "scheme": "doi"}], "resource_type": {"title": "Conference paper", "type": "publication", "subtype": "conferencepaper"}, "meeting": {"title": "20th International Conference On Principles Of DIstributed Systems", "acronym": "OPODIS'16", "dates": "13-16. December 2016", "place": "Madrid, Spain", "url": "http://opodis2016.etsisi.upm.es/"}, "license": {"id": "cc-by-sa-4.0"}, "grants": [{"code": "643964", "internal_id": "10.13039/501100000780::643964", "funder": {"name": "European Commission", "doi": "10.13039/501100000780", "acronym": "EC"}, "title": "USER-CENTRIC MANAGEMENT OF SECURITY AND DEPENDABILITY IN CLOUDS OF CLOUDS", "acronym": "SUPERCLOUD", "program": "H2020-EU.2.1.1.", "url": "https://cordis.europa.eu/projects/643964"}], "communities": [{"id": "eu"}, {"id": "supercloud"}], "relations": {"version": [{"index": 0, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "793750"}}]}}, "title": "Non-determinism in Byzantine Fault-Tolerant Replication", "links": {"self": "https://zenodo.org/api/records/439050", "self_html": "https://zenodo.org/records/439050", "preview_html": "https://zenodo.org/records/439050?preview=1", "doi": "https://doi.org/10.5281/zenodo.439050", "self_doi": "https://doi.org/10.5281/zenodo.439050", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.439050", "reserve_doi": "https://zenodo.org/api/records/439050/draft/pids/doi", "parent": "https://zenodo.org/api/records/793750", "parent_html": "https://zenodo.org/records/793750", "parent_doi": "https://doi.org/", "parent_doi_html": "https://zenodo.org/doi/", "self_iiif_manifest": "https://zenodo.org/api/iiif/record:439050/manifest", "self_iiif_sequence": "https://zenodo.org/api/iiif/record:439050/sequence/default", "files": "https://zenodo.org/api/records/439050/files", "media_files": "https://zenodo.org/api/records/439050/media-files", "thumbnails": {"10": "https://zenodo.org/api/iiif/record:439050:Non-determinism-in-Byzantine-Fault-Tolerant-Replication.pdf/full/%5E10,/0/default.jpg", "50": "https://zenodo.org/api/iiif/record:439050:Non-determinism-in-Byzantine-Fault-Tolerant-Replication.pdf/full/%5E50,/0/default.jpg", "100": "https://zenodo.org/api/iiif/record:439050:Non-determinism-in-Byzantine-Fault-Tolerant-Replication.pdf/full/%5E100,/0/d